# Django (genera un valor distinto para tu entorno local)
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local, ejecutado con Docker
POSTGRES_DB=paymentflow
POSTGRES_USER=paymentflow
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional. The application works without Redis in this MVP.
REDIS_URL=
